---
/**
 * Trang chu: tinh trang du lieu + ba chi so thi truong.
 *
 * # Trang nay khong bao gio lap cho trong bang so lieu gia
 *
 * Backend khong voi toi duoc, hoac chua co du bao nao, deu duoc noi thang. Mot trang hien "50%"
 * khi khong co du lieu la noi sai — va 50% con la mot du bao CO NOI DUNG (can bang that), nen no
 * la cach noi sai te nhat.
 */
import PublicLayout from '@layouts/PublicLayout.astro';
import { apiGet } from '@core/api/client';
import type { DataStatus, ForecastResponse } from '@core/api/types';
import { STALE_LAG_DAYS, formatProbability } from '@core/api/types';

const CHI_SO = ['VNINDEX', 'HNXINDEX', 'UPCOMINDEX'] as const;

const [status, ...chiSo] = await Promise.all([
    apiGet<DataStatus>('/api/v1/data-status'),
    ...CHI_SO.map((s) => apiGet<ForecastResponse>(`/api/v1/forecasts?symbol=${s}`)),
]);

const cu =
    status.kind === 'ok' &&
    status.data.lagDays !== null &&
    status.data.lagDays > STALE_LAG_DAYS;

const disclaimer = status.kind === 'ok' ? status.data.disclaimer : null;
---

<PublicLayout
  title="Tổng quan"
  description="Dự báo xác suất tăng / không tăng cho thị trường, ngành và cổ phiếu Việt Nam."
>
  <h1 class="text-2xl font-bold mb-2">Xác suất tăng / không tăng</h1>
  <p class="text-[var(--color-muted)] mb-8 text-sm">
    Thị trường, ngành và cổ phiếu Việt Nam ở 5 kỳ hạn: 1, 5, 21, 63 và 252 phiên.
    MERIX chỉ phát xác suất — không có khuyến nghị mua hay bán.
  </p>

  {status.kind === 'ok' ? (
    <section class="rounded-xl border border-[var(--color-line)] bg-[var(--color-panel)] p-5 mb-8">
      <h2 class="text-sm font-semibold mb-3">Tình trạng dữ liệu</h2>
      <dl class="text-sm grid grid-cols-1 sm:grid-cols-2 gap-y-2 gap-x-6">
        <dt class="text-[var(--color-muted)]">Phiên mới nhất</dt>
        <dd class="tabular-nums">{status.data.latestTradingDate ?? 'chưa có'}</dd>

        <dt class="text-[var(--color-muted)]">Trễ so với hôm nay</dt>
        <dd class:list={['tabular-nums', cu ? 'text-[var(--color-warn)] font-semibold' : '']}>
          {status.data.lagDays === null ? '—' : `${status.data.lagDays} ngày`}
        </dd>

        <dt class="text-[var(--color-muted)]">Tài sản có giá</dt>
        <dd class="tabular-nums">{status.data.assetsWithPrices.toLocaleString('vi-VN')}</dd>

        <dt class="text-[var(--color-muted)]">Dòng giá</dt>
        <dd class="tabular-nums">{status.data.priceRows.toLocaleString('vi-VN')}</dd>

        <dt class="text-[var(--color-muted)]">Dự báo phát được</dt>
        <dd class="tabular-nums">{status.data.liveForecasts.toLocaleString('vi-VN')}</dd>

        <dt class="text-[var(--color-muted)]">Dự báo không phát được</dt>
        <dd class="tabular-nums">{status.data.abstainedForecasts.toLocaleString('vi-VN')}</dd>

        <dt class="text-[var(--color-muted)]">Sự kiện doanh nghiệp</dt>
        <dd class="tabular-nums">{status.data.corporateActionCoverage} mã</dd>

        <dt class="text-[var(--color-muted)]">Phiên bản tập feature</dt>
        <dd><code class="text-xs">{status.data.featureSetVersion}</code></dd>
      </dl>

      {cu && (
        <p class="mt-4 text-sm text-[var(--color-warn)]">
          Dữ liệu đã cũ hơn {STALE_LAG_DAYS} ngày. Các xác suất bên dưới được tính trên dữ liệu
          tới {status.data.latestTradingDate}, không phải hôm nay.
        </p>
      )}
    </section>
  ) : (
    <section class="rounded-xl border border-[var(--color-warn)] bg-[var(--color-panel)] p-5 mb-8">
      <h2 class="text-sm font-semibold mb-2 text-[var(--color-warn)]">Không lấy được dữ liệu</h2>
      <p class="text-sm text-[var(--color-muted)]">
        Backend trả về lỗi <code class="text-xs">{status.code}</code>: {status.message}
      </p>
      <p class="text-sm text-[var(--color-muted)] mt-2">
        Trang này <strong>không</strong> hiển thị số liệu giả để lấp chỗ trống.
      </p>
    </section>
  )}

  <h2 class="text-lg font-semibold mb-4">Chỉ số thị trường</h2>

  <div class="grid gap-4 sm:grid-cols-3">
    {chiSo.map((r, i) => {
      const symbol = CHI_SO[i];
      if (r.kind !== 'ok') {
        return (
          <article class="rounded-xl border border-[var(--color-line)] bg-[var(--color-panel)] p-4">
            <h3 class="font-semibold">{symbol}</h3>
            <p class="text-sm text-[var(--color-muted)] mt-2">
              Chưa có dự báo ({r.code}).
            </p>
          </article>
        );
      }
      const d = r.data;
      // Ky han 21 phien la moc dai dien cho trang tong quan: du dai de co noi dung, du ngan de
      // con kiem chung duoc. Khong co thi lay ky han ngan nhat phat duoc.
      const chinh =
        d.horizons.find((h) => h.horizonSessions === 21 && h.probabilityUp !== null) ??
        d.horizons.find((h) => h.probabilityUp !== null);
      const p = formatProbability(chinh?.probabilityUp ?? null);
      return (
        <a
          href={`/asset/${encodeURIComponent(d.asset.symbol)}`}
          class="rounded-xl border border-[var(--color-line)] bg-[var(--color-panel)] p-4 block hover:border-[var(--color-accent)] transition-colors"
        >
          <h3 class="font-semibold">{d.asset.symbol}</h3>
          <p class="text-xs text-[var(--color-muted)] mb-3">{d.asset.name}</p>
          {p !== null && chinh ? (
            <>
              <p class="text-3xl font-bold tabular-nums">{p}</p>
              <p class="text-xs text-[var(--color-muted)] mt-1">
                xác suất tăng sau {chinh.horizonSessions} phiên
              </p>
            </>
          ) : (
            <p class="text-sm text-[var(--color-muted)]">
              Không phát dự báo ở kỳ hạn nào.
            </p>
          )}
        </a>
      );
    })}
  </div>

  <h2 class="text-lg font-semibold mt-8 mb-3">Tra cứu mã</h2>
  <form method="get" action="/asset" class="flex gap-2 flex-wrap">
    <label class="sr-only" for="symbol">Mã cần xem</label>
    <input
      id="symbol"
      name="symbol"
      type="text"
      required
      placeholder="VNINDEX · ACB · ICB2300"
      class="flex-1 min-w-48 rounded-lg border border-[var(--color-line)] bg-transparent px-3 py-2 text-sm"
    />
    <button
      type="submit"
      class="rounded-lg border border-[var(--color-accent)] px-4 py-2 text-sm font-medium"
      >Xem</button
    >
  </form>

  <p slot="disclaimer">
    {disclaimer ?? 'Thông tin nghiên cứu, không phải tư vấn đầu tư.'}
  </p>
</PublicLayout>
