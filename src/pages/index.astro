---
import PublicLayout from '@layouts/PublicLayout.astro';
import {apiGet} from '@core/api/client';
import type {DataStatus,ForecastResponse} from '@core/api/types';
import {VALIDATION_LABELS} from '@core/api/types';
import {DEFAULT_HORIZON,classify} from '@core/api/target';
import {compactProbabilityHtml} from '@modules/workspace/probabilityView';
import {money,percent,priceChange,stale,type MarketSnapshot,type MarketSeries,type WorkspaceData} from '@core/api/market';
import PriceChart from '@modules/workspace/PriceChart.astro';
import Probability from '@modules/workspace/Probability.astro';
import StockRows from '@modules/workspace/StockRows.astro';
const search=(Astro.url.searchParams.get('search')??'').trim().slice(0,120);
const sector=(Astro.url.searchParams.get('sector')??'').trim().slice(0,20);
const params=new URLSearchParams({level:'STOCK',limit:'24',horizon:String(DEFAULT_HORIZON)});if(search)params.set('search',search);if(sector)params.set('sector',sector);
const [status,markets,sectors,stocks,series,forecast]=await Promise.all([
 apiGet<DataStatus>('/api/v1/data-status'),apiGet<MarketSnapshot>(`/api/v1/market-snapshot?level=MARKET&limit=100&horizon=${DEFAULT_HORIZON}`),apiGet<MarketSnapshot>(`/api/v1/market-snapshot?level=SECTOR&limit=100&horizon=${DEFAULT_HORIZON}`),apiGet<MarketSnapshot>(`/api/v1/market-snapshot?${params}`),apiGet<MarketSeries>('/api/v1/market-series?symbol=VNINDEX&limit=63'),apiGet<ForecastResponse>('/api/v1/forecasts?symbol=VNINDEX'),
]);
const state:WorkspaceData={markets:markets.kind==='ok'?markets.data.items:[],sectors:sectors.kind==='ok'?sectors.data.items:[],stocks:stocks.kind==='ok'?stocks.data:null,series:series.kind==='ok'?series.data:null,forecast:forecast.kind==='ok'?forecast.data:null,selected:'VNINDEX',errors:[],search,sector,stockError:stocks.kind==='error'?stocks.message:null};
const disclaimer=status.kind==='ok'?status.data.disclaimer:forecast.kind==='ok'?forecast.data.disclaimer:'Thông tin nghiên cứu, không phải tư vấn đầu tư.';
---
<PublicLayout title="Tổng quan" description="Không gian nghiên cứu định lượng thị trường Việt Nam: diễn biến giá, xác suất theo kỳ hạn và tình trạng kiểm chứng.">
<div id="workspace-data" data-initial={JSON.stringify(state)}>
<div class="page-heading public-intro"><div><div class="eyebrow">THỊ TRƯỜNG VIỆT NAM · QUANTITATIVE RESEARCH</div><h1>Một góc nhìn. Nhiều xác suất.</h1><p>Đọc chuyển động thị trường qua lăng kính dữ liệu.</p></div><div class="session">Phiên dữ liệu gần nhất<small>{status.kind==='ok'?status.data.latestTradingDate??'Chưa có':'Không kết nối'}</small></div></div>
{status.kind==='ok'?<div class:list={['data-notice',stale(status.data.latestTradingDate)&&'warning']}><strong>{stale(status.data.latestTradingDate)?'Dữ liệu đã cũ.':'Tình trạng dữ liệu'}</strong> Giá tới {status.data.latestTradingDate??'chưa có'} · {status.data.assetsWithPrices.toLocaleString('vi-VN')} tài sản có giá · Không phải bảng giá thời gian thực. {status.data.lagDays!==null&&`Trễ ${status.data.lagDays} ngày lịch.`}</div>:<div class="data-notice error" role="status">Không đọc được trạng thái dữ liệu: {status.message}</div>}
<noscript><p class="noscript-note">Bạn đang xem dữ liệu được dựng từ máy chủ. Bật JavaScript để đổi biểu đồ, kỳ hạn và lưu danh sách theo dõi. Có thể tìm tài sản bằng ô tìm kiếm và xem đầy đủ kỳ hạn trong trang chi tiết.</p></noscript>
<section class="market-cards" aria-label="Chỉ số thị trường">{state.markets.map(a=>{const c=priceChange(a.prices);return <button class:list={['market-card',a.symbol==='VNINDEX'&&'selected']} data-market={a.symbol} aria-pressed={a.symbol==='VNINDEX'}><div class="market-card-top"><span class="index-symbol">{a.symbol}<span class="exchange">{a.exchange??'Chỉ số'}</span></span><span>↗</span></div><div class="market-price"><strong>{money(a.prices.at(-1)?.close)}</strong><span class:list={['change',c!==null&&c<0&&'negative']}>{c===null?'—':`${c>0?'+':''}${percent(c)}`}</span></div><div class="market-card-bottom"><span>Xác suất tăng · {DEFAULT_HORIZON} phiên</span><Fragment set:html={compactProbabilityHtml(a.forecast)}/></div><p class="market-state">{a.forecast?VALIDATION_LABELS[a.forecast.validationStatus]:'Chưa có dự báo'} · {a.prices.at(-1)?.date??'Chưa có giá'}{stale(a.prices.at(-1)?.date)&&' · Giá cũ'}</p></button>;})}</section>
{markets.kind==='error'&&<p class="data-notice error">Không tải được chỉ số thị trường: {markets.message}</p>}
<div class="analysis-grid"><PriceChart series={state.series} symbol="VNINDEX" error={series.kind==='error'?series.message:undefined}/><Probability forecast={state.forecast} error={forecast.kind==='error'?forecast.message:undefined}/></div>
<div class="bottom-grid"><section class="panel stock-panel" id="stocks-section" aria-labelledby="stocks-title"><div class="panel-heading"><div><h2 id="stocks-title">Khám phá cổ phiếu</h2><p>Giá điều chỉnh · xác suất từ mô hình equal_ensemble</p></div><span class="table-period">{DEFAULT_HORIZON} phiên</span></div><div class="table-controls"><div class="table-tabs"><button data-filter="all" class="active" aria-pressed="true">Tất cả cổ phiếu</button><button data-filter="watchlist" aria-pressed="false">Đang theo dõi</button></div><label class="sector-select"><span class="sr-only">Lọc theo ngành</span><select id="sector-filter"><option value="">Tất cả ngành</option>{state.sectors.map(s=><option value={s.sector??s.symbol.replace(/^ICB/,'')} selected={sector===(s.sector??s.symbol.replace(/^ICB/,''))}>{s.name}</option>)}</select></label></div><p class="data-loading-message" id="stocks-message" role="status">{search&&`Kết quả cho “${search}”`}</p><div class="table-scroll"><table><caption class="sr-only">Cổ phiếu, giá điều chỉnh, xác suất tăng sau {DEFAULT_HORIZON} phiên và trạng thái kiểm chứng</caption><thead><tr><th scope="col"><span class="sr-only">Theo dõi</span></th><th scope="col">Tài sản</th><th scope="col" class="numeric">Giá / VND</th><th scope="col" class="numeric">XS tăng</th><th scope="col">Sàn</th><th scope="col">Trạng thái</th></tr></thead><tbody id="stocks-body"><StockRows items={state.stocks?.items??[]}/></tbody></table><p id="empty-state" hidden={!!state.stocks?.items.length}>{state.stockError??'Không có tài sản khớp bộ lọc.'}</p></div><div class="table-footer"><span id="results-count">Hiển thị {state.stocks?.items.length??0} tài sản</span><button id="load-more" class="load-more" hidden={!state.stocks?.nextCursor}>Xem thêm</button></div><p class="sector-caption">Danh sách theo dõi được lưu trên trình duyệt này, tối đa 100 mã.</p></section>
<section class="panel sector-panel" id="sectors-section" aria-labelledby="sectors-title"><div class="panel-heading"><div><h2 id="sectors-title">Nhịp đập ngành</h2><p>Xác suất tăng · {DEFAULT_HORIZON} phiên · equal_ensemble</p></div></div><div class="sector-map">{state.sectors.map(s=><button class:list={['sector-tile',(!s.forecast||classify(s.forecast).kind!=='signal')&&'empty',s.forecast&&classify(s.forecast).kind==='signal'&&s.forecast.probabilityUp!<.5&&'cool']} data-sector={s.sector??s.symbol.replace(/^ICB/,'')} style={`--tile-alpha:${s.forecast&&classify(s.forecast).kind==='signal'?.1+s.forecast.probabilityUp!*.25:.08}`}><span>{s.name}</span><Fragment set:html={compactProbabilityHtml(s.forecast)}/><small class="sector-validity">{s.forecast?VALIDATION_LABELS[s.forecast.validationStatus]:'Chưa có dự báo'}{s.forecast&&stale(s.forecast.dataThrough)&&' · Dữ liệu cũ'}</small></button>)}</div>{sectors.kind==='error'&&<p class="panel-empty">Không tải được dữ liệu ngành: {sectors.message}</p>}<p class="sector-caption">Chọn ngành để lọc cổ phiếu. Xác suất không phải khuyến nghị đầu tư.</p></section></div>
{status.kind==='ok'&&<dl class="data-stats"><div><dt>Dòng giá đã lưu</dt><dd>{status.data.priceRows.toLocaleString('vi-VN')}</dd></div><div><dt>Bản ghi có xác suất</dt><dd>{status.data.liveForecasts.toLocaleString('vi-VN')}</dd></div><div><dt>Bản ghi không phát dự báo</dt><dd>{status.data.abstainedForecasts.toLocaleString('vi-VN')}</dd></div><div><dt>Bao phủ sự kiện doanh nghiệp</dt><dd>{status.data.corporateActionCoverage}</dd></div></dl>}
</div><p slot="disclaimer">{disclaimer}</p><script src="../modules/workspace/dashboard.ts"></script>
</PublicLayout>
