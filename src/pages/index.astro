---
import PublicLayout from '@layouts/PublicLayout.astro';
import { apiGet } from '@core/api/client';
import type { DataStatus } from '@core/api/types';

// Phase 1: endpoint /api/v1/data-status chua ton tai (Phase 4 moi lam).
// Trang van phai xu ly tu te truong hop goi that bai — do chinh la thu dang duoc kiem thu o day.
const status = await apiGet<DataStatus>('/api/v1/data-status');
---

<PublicLayout title="Tong quan" description="Du bao xac suat tang / khong tang cho thi truong, nganh va co phieu Viet Nam.">
  <h1 class="text-2xl font-bold mb-2">Xac suat tang / khong tang</h1>
  <p class="text-[var(--color-muted)] mb-8 text-sm">
    Thi truong, nganh va co phieu Viet Nam o 5 ky han: 1, 5, 21, 63 va 252 phien.
  </p>

  {status.kind === 'ok' ? (
    <section class="rounded-xl border border-[var(--color-line)] bg-[var(--color-panel)] p-5">
      <h2 class="text-sm font-semibold mb-3">Trang thai du lieu</h2>
      <dl class="text-sm grid grid-cols-2 gap-y-2">
        <dt class="text-[var(--color-muted)]">Phien moi nhat</dt>
        <dd>{status.data.latestTradingDate ?? 'chua co'}</dd>
        <dt class="text-[var(--color-muted)]">Cham so voi hom nay</dt>
        <dd>{status.data.sessionsBehind} phien</dd>
      </dl>
    </section>
  ) : (
    <section class="rounded-xl border border-[var(--color-warn)] bg-[var(--color-panel)] p-5">
      <h2 class="text-sm font-semibold mb-2 text-[var(--color-warn)]">Chua co du lieu</h2>
      <p class="text-sm text-[var(--color-muted)]">
        Khong lay duoc trang thai du lieu tu backend ({status.code}).
        Phase 1 moi dung o khung he thong — endpoint du bao se co o Phase 4.
      </p>
      <p class="text-sm text-[var(--color-muted)] mt-2">
        Trang nay <strong>khong</strong> hien so lieu gia de lap cho trong.
      </p>
    </section>
  )}

  <p slot="disclaimer">
    {status.kind === 'ok'
      ? status.data.disclaimer
      : 'Thong tin nghien cuu, khong phai tu van dau tu.'}
  </p>
</PublicLayout>
