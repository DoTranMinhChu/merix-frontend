---
import PublicLayout from '@layouts/PublicLayout.astro';
import {apiGet} from '@core/api/client';
import type {ForecastResponse} from '@core/api/types';
import {LEVEL_LABELS} from '@core/api/types';
import type {MarketSeries} from '@core/api/market';
import {stale} from '@core/api/market';
import PriceChart from '@modules/workspace/PriceChart.astro';
import Probability from '@modules/workspace/Probability.astro';
import ForecastTable from '@modules/forecast/ForecastTable.astro';
import ValidationBanner from '@modules/forecast/ValidationBanner.astro';
const ma=(Astro.params.symbol??'').trim().toUpperCase();
const [res,series]=await Promise.all([apiGet<ForecastResponse>(`/api/v1/forecasts?symbol=${encodeURIComponent(ma)}`),apiGet<MarketSeries>(`/api/v1/market-series?symbol=${encodeURIComponent(ma)}&limit=63`)]);
if(res.kind==='error'&&res.status===404)Astro.response.status=404;
const title=res.kind==='ok'?`${res.data.asset.symbol} — ${res.data.asset.name}`:ma||'Tra cứu';
const forecast=res.kind==='ok'?res.data:null;
const initial={symbol:ma,forecast,series:series.kind==='ok'?series.data:null};
const notReady=res.kind==='error'&&res.code==='FORECAST_NOT_READY';
---
<PublicLayout title={title} description={`Giá điều chỉnh và xác suất tăng / không tăng của ${ma} ở 5 kỳ hạn giao dịch.`}>
<div id="asset-workspace" data-initial={JSON.stringify(initial)}>
<nav aria-label="Đường dẫn" class="mb-6"><a class="text-[var(--color-muted)]" href="/">← Tổng quan thị trường</a></nav>
<div class="detail-heading"><div><h1>{ma}</h1><p>{forecast?.asset.name??(notReady?'Tài sản chưa có dự báo':'Chi tiết tài sản')}{forecast&&` · ${LEVEL_LABELS[forecast.asset.level]} · ${forecast.asset.exchange??'Chỉ số'}`}</p></div>{(forecast||series.kind==='ok')&&<button id="asset-watch" data-symbol={ma} aria-pressed="false">☆ Theo dõi</button>}</div>
{res.kind==='error'&&<section class="data-notice error"><h2>{notReady?'Chưa có dự báo cho mã này':res.status===404?'Không tìm thấy mã này':'Không lấy được dự báo'}</h2><p>{res.message}</p>{notReady&&<p>Mã này có trong hệ thống. Dự báo được tính theo lô; dữ liệu chưa đủ sẽ không được thay bằng một xác suất giả định.</p>}</section>}
{forecast&&stale(forecast.dataThrough)&&<p class="data-notice warning">Dữ liệu dự báo đã cũ, tới phiên {forecast.dataThrough}. Đây không phải dự báo dựa trên giá hôm nay.</p>}
<div class="analysis-grid detail-chart"><PriceChart series={initial.series} symbol={ma} error={series.kind==='error'?series.message:undefined}/><Probability forecast={forecast} error={res.kind==='error'?res.message:undefined}/></div>
{forecast&&<><ValidationBanner status={forecast.validationStatus} modelVersion={forecast.modelVersion}/><section class="panel detail-table"><ForecastTable horizons={forecast.horizons}/></section><section class="panel detail-evidence p-6"><h2>Dự báo này dựa trên gì?</h2><dl><dt>Thời điểm ra quyết định</dt><dd>{forecast.asOf}</dd><dt>Dữ liệu tới phiên</dt><dd>{forecast.dataThrough}</dd><dt>Mô hình</dt><dd>{forecast.modelVersion}</dd></dl><p class="text-sm text-[var(--color-muted)]">Thời điểm ra quyết định là mốc dữ liệu đã khả dụng trước khi tính toán. Dữ liệu tới phiên là ngày giao dịch mới nhất được dùng. “Không tăng” bao gồm cả giá đi ngang.</p><a class="text-button" href="/methodology">Tìm hiểu phương pháp và giới hạn ↗</a></section></>}
</div><p slot="disclaimer">{forecast?.disclaimer??'Thông tin nghiên cứu, không phải tư vấn đầu tư.'}</p><script src="../../modules/workspace/asset.ts"></script>
</PublicLayout>
