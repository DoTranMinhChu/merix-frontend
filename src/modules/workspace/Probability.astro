---
import type {ForecastResponse} from '@core/api/types';
import {DEFAULT_HORIZON} from '@core/api/target';
import {probabilityBodyHtml} from './probabilityView';
interface Props {forecast:ForecastResponse|null;error?:string}
const {forecast,error}=Astro.props;
---
<section class="panel probability-panel" aria-labelledby="prob-title" id="probability-panel"><div class="panel-heading"><h2 id="prob-title">Lăng kính xác suất</h2><a href="/methodology" aria-label="Tìm hiểu cách tính xác suất">ⓘ</a></div><p class="muted">Khả năng giá tăng sau <strong id="horizon-label">{DEFAULT_HORIZON} phiên</strong></p><div class="horizon-control" aria-label="Kỳ hạn dự báo">{[1,5,21,63,252].map(n=><button type="button" data-horizon={n} class:list={[n===DEFAULT_HORIZON&&'active']} aria-pressed={n===DEFAULT_HORIZON}>{n}<small>phiên</small></button>)}</div>
<div id="probability-body" set:html={probabilityBodyHtml(forecast,DEFAULT_HORIZON,error,false)}></div><a class="text-button" href="/methodology">Hiểu phương pháp & giới hạn <span>↗</span></a></section>
