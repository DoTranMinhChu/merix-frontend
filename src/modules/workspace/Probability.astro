---
import type {ForecastResponse} from '@core/api/types';
import {ABSTAIN_LABELS,VALIDATION_LABELS} from '@core/api/types';
import {percent,stale} from '@core/api/market';
interface Props {forecast:ForecastResponse|null;error?:string}
const {forecast,error}=Astro.props;const h=forecast?.horizons.find(h=>h.horizonSessions===21);const p=h?.probabilityUp??null;
---
<section class="panel probability-panel" aria-labelledby="prob-title" id="probability-panel"><div class="panel-heading"><h2 id="prob-title">Lăng kính xác suất</h2><a href="/methodology" aria-label="Tìm hiểu cách tính xác suất">ⓘ</a></div><p class="muted">Khả năng tăng sau <strong id="horizon-label">21 phiên</strong></p><div class="horizon-control" aria-label="Kỳ hạn dự báo">{[1,5,21,63,252].map(n=><button type="button" data-horizon={n} class:list={[n===21&&'active']} aria-pressed={n===21}>{n}<small>phiên</small></button>)}</div>
<div id="probability-body">{p!==null?<><div class="probability-gauge"><svg viewBox="0 0 250 145" aria-hidden="true"><path d="M25 125 A100 100 0 0 1 225 125" class="gauge-track"/><path d="M25 125 A100 100 0 0 1 225 125" class="gauge-value" pathLength="100" stroke-dasharray={`${p*100} 100`}/><text x="18" y="144">0%</text><text x="209" y="144">100%</text></svg><div><span>{percent(p)}</span><small>Xác suất tăng</small></div></div><div class="probability-breakdown"><span>Tăng <strong>{percent(p)}</strong></span><span>Không tăng <strong>{percent(h?.probabilityNotUp)}</strong></span></div></>:<p class="panel-empty">Không phát dự báo<br/>{h?.abstainReason?ABSTAIN_LABELS[h.abstainReason]:error??'Chưa có kết quả cho kỳ hạn này.'}</p>}
{forecast&&<><div class="model-note"><div><strong>{VALIDATION_LABELS[(h?.validationStatus??forecast.validationStatus)]}</strong><p>{(h?.validationStatus??forecast.validationStatus)==='VALIDATED_PROSPECTIVE'?'Đã kiểm chứng tiến cứu; vẫn có sai số.':'Chưa có bằng chứng kiểm chứng tiến cứu đáng tin cậy. Xác suất không phải mức độ chắc chắn.'}</p></div></div><p class="probability-meta">Dữ liệu tới {(h?.dataThrough??forecast.dataThrough)}{stale((h?.dataThrough??forecast.dataThrough))&&' · Dữ liệu đã cũ'}<br/>Mô hình: {(h?.modelVersion??forecast.modelVersion)}<br/>Phiên đích: {h?.targetDate??'Chưa xác định'}</p></>}</div><a class="text-button" href="/methodology">Hiểu phương pháp & giới hạn <span>↗</span></a></section>
